---
import { Image } from 'astro:assets';
const { href, image, discourseLink, preprintLink, journalLink } = Astro.props;
---

<div class="col-span-1 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
  <div class="bg-white dark:bg-gray-900 shadow-md rounded-lg overflow-hidden flex flex-col h-full">
    
    <!-- Full-width, fully visible cover image -->
    <a href={href} class="block w-full h-64 md:h-72 lg:h-80 flex items-center justify-center bg-gray-100 dark:bg-gray-800">
      <Image
        src={image?.src}
        alt={image?.alt || ''}
        class="max-w-full max-h-full object-contain"
      />
    </a>

    <!-- Paper info -->
    <div class="flex flex-col items-center text-center p-4 mt-auto">
      <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-gray-100">
        {image?.alt}
      </h3>
      <div class="flex flex-wrap justify-center gap-2">
        {discourseLink && (
          <a
            href={discourseLink}
            class="text-sm text-blue-600 hover:underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Discourse
          </a>
        )}
        {preprintLink && (
          <a
            href={preprintLink}
            class="text-sm text-gray-600 hover:underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Preprint
          </a>
        )}
        {journalLink && (
          <a
            href={journalLink}
            class="text-sm text-green-600 hover:underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Journal
          </a>
        )}
      </div>
    </div>
  </div>
</div>

