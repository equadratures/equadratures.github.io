---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import CircularMenu from '~/components/widgets/CircularMenu.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import Team from '~/components/widgets/Team.astro';

const metadata = {
  title: 'Learn continuous structure | equadratures',
  ignoreTitleTemplate: true,
};

import { METADATA } from 'astrowind:config';
import { fetchPyPIDownloadStats, fetchGitHubStats } from '../utils/custom-utils'

const github_org = METADATA.github.org
const github_repo  = METADATA.github.repo

const download_stats = await fetchPyPIDownloadStats(METADATA.package.name.toLowerCase());
const n_downloads_last_month = download_stats.data.last_month
const github_stats = await fetchGitHubStats(github_org, github_repo);

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif}')
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero2
    actions={[
      {
        variant: 'primary',
        text: 'Documentation',
        href: 'https://equadratures.org/documentation/',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Learn more', href: '#feature-notebooks' },
    ]}
    image={{ src: '~/assets/images/logo-opt.svg', alt: 'Equadratures logo', style: 'object-fit: contain;' }}
  >
    <Fragment slot="title">
      equadratures
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">equadratures</span> is an open-source python framework for fitting models to data.</span
      >
      It may be used for polynomial regression, sparse polynomial approximation, subspace-based dimension reduction, polynomial chaos, and more recently for kernel-based learning.
    </Fragment>
  </Hero2>

  <!-- CircularMenu Widget ******************* -->
  <div class="text-center max-w-5xl m-auto" id="feature-notebooks">
    <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      Feature Notebooks
    </p>
  </div>
  <div class="motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade" id="feature-notebooks">
    <CircularMenu />
  </div>

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Downloads last month', amount: `${n_downloads_last_month}`},
      { title: 'GitHub Stars', amount: `${github_stats.n_stars}` },
      { title: 'GitHub Forks', amount: `${github_stats.n_forks}` },
      { title: 'GitHub Watchers', amount: `${github_stats.n_watchers}` },
    ]}
  />


  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`The blog is used to display latest equadratures posts.
                `}
  />


  <!-- Team Widget *************** -->

  <Team
    id="team-members"
    title="The equadratures Team"
    subtitle="Collaborators managing various aspects of the project."
    tagline="Team"
    description="The equadratures project is a collaboration between multiple institutions. It is made possible thanks to the open-source contributions of many academic and industrial organisations. The names here are only those who continually manage the project, but many more have been responsible for the innovation and research!"
    team={
    [
      {
        name: 'Pranay Seshadri',
        job: 'Associate Professor',
        description: 'Georgia Institute of Technology',
        image: {src: images['/src/assets/images/team/pranay.jpeg'](),
                alt: 'Picture of Pranay Seshadri'
              },
        socials: [
          {
            icon: 'arcticons:earth',
            href: 'https://psesh.github.io/'
          },
          {
            icon: 'arcticons:researchgate',
            href: 'https://www.researchgate.net/profile/Pranay-Seshadri-3'
          },
          {
            icon: 'arcticons:linkedin',
            href: 'https://www.linkedin.com/in/pranay-seshadri-0815971b0/'
          },
          {
            icon: 'arcticons:github',
            href: 'https://github.com/psesh'
          },
        ],
      },
      {
        name: 'Andrew Duncan, PhD',
        job: 'Senior Lecturer',
        description: 'Imperial College London',
        image: {src: images['/src/assets/images/team/andrew.jpeg'](),
                alt: 'Picture of Andrew Duncan'
              },
        socials: [
          {
            icon: 'arcticons:earth',
            href: 'http://wwwf.imperial.ac.uk/~aduncan/'
          },
          {
            icon: 'arcticons:researchgate',
            href: 'https://www.researchgate.net/profile/Andrew-Duncan-23'
          },
          {
            icon: 'arcticons:linkedin',
            href: 'https://www.linkedin.com/in/andrew-duncan-404690140'
          },
          {
            icon: 'arcticons:github',
            href: 'https://github.com/aduncan001'
          },
        ],
      },
      {
        name: 'Bryn Noel Ubald',
        job: 'Research Software Engineer',
        description: 'British Antarctic Survey',
        image: {src: images['/src/assets/images/team/bryn.jpeg'](),
                alt: 'Picture of Bryn Noel Ubald'
              },
        socials: [
          {
            icon: 'arcticons:earth',
            href: 'https://www.brynnoelubald.com/'
          },
          {
            icon: 'arcticons:researchgate',
            href: 'https://www.researchgate.net/profile/Bryn-Ubald'
          },
          {
            icon: 'arcticons:linkedin',
            href: 'https://www.linkedin.com/in/bryn-noel-ubald/'
          },
          {
            icon: 'arcticons:github',
            href: 'https://github.com/bnubald'
          },
        ],
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Team>


  <div class="flex justify-center">
    <div class="space-y-4">
      <!-- Button to toggle collapsible content -->
      <button
        id="toggle-button"
        class="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-200"
        onclick="toggleCollapsible()">
        Former Contributors
      </button>
    </div>
  </div>

  <!-- Collapsible former contributors content -->
  <div
    id="collapsible-content"
    class="transition-all duration-300 ease-in-out overflow-hidden max-h-0 bg-gray-100 p-4 rounded-md mt-2"
    style="max-height: 0; background-color: transparent;">

    <Team
      id="former-team-members"
      description="The equadratures project is a collaboration between multiple institutions. It is made possible thanks to the open-source contributions of many academic and industrial organisations. The names here are only those who continually manage the project, but many more have been responsible for the innovation and research!"
      style=""
      team={
      [
        {
          name: 'Peter Yatsyshin',
          job: 'Research Associate',
          description: 'The Alan Turing Institute',
          image: {src: images['/src/assets/images/team/peter.jpeg'](),
                  alt: 'Picture of Peter Yatsyshin'
                },
          socials: [
            {
              icon: 'arcticons:earth',
              href: 'https://www.yatsyshin.com/'
            },
            {
              icon: 'arcticons:researchgate',
              href: 'https://www.researchgate.net/profile/Peter-Yatsyshin'
            },
            {
              icon: 'arcticons:linkedin',
              href: 'https://www.linkedin.com/in/peter-yatsyshin-phd/'
            },
            {
              icon: 'arcticons:github',
              href: 'https://github.com/pyatsysh'
            },
          ],
        },
        {
          name: 'Elizabeth Mone',
          job: 'Undergraduate',
          description: 'Georgia Institute of Technology',
          image: {src: images['/src/assets/images/team/elizabeth.jpeg'](),
                  alt: 'Picture of Elizabeth Mone'
                },
          socials: [
            {
              icon: 'arcticons:linkedin',
              href: 'https://www.linkedin.com/in/elizabeth-mone-824b53265/'
            },
            {
              icon: 'arcticons:github',
              href: 'https://github.com/03emone'
            },
          ],
        },
        {
          name: 'Roshan Amir',
          job: 'Undergraduate',
          description: 'Georgia Institute of Technology',
          image: {src: images['/src/assets/images/team/roshan.jpeg'](),
                  alt: 'Picture of Roshan Amir'
                },
          socials: [
            {
              icon: 'arcticons:linkedin',
              href: 'https://www.linkedin.com/in/roshan-amir-b7564a209/'
            },
            {
              icon: 'arcticons:github',
              href: 'https://github.com/RoshuAmir918'
            },
          ],
        },
      ]}
    >
      <Fragment slot="bg">
        <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
      </Fragment>
    </Team>

    <div class="grid gap-x-6 sm:gap-y-8 grid-cols-1 max-w-[283px] w-full mx-auto">
      <div class="relative flex flex-col justify-start intersect-once intersect-quarter intercept-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade team-grid text-center bg-page items-center p-6 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-800">
        <div class="my-5">
          <p>Chun Yui Wong, PhD</p>
          <p>Ashley Scillitoe, PhD</p>
          <p>Barney Hill</p>
          <p>Tiziano Ghisu, PhD</p>
          <p>Simardeep Singh Sethi</p>
          <p>Henry Shaowu Yuchi</p>
          <p>James Gross, PhD</p>
          <p Michaek Donnelly</p>
          <p>Irene Virdis, PhD</p>
          <p>Taran Kalra, PhD</p>
        </div>
    </div>
  </div>


</Layout>

<script is:inline>
  function toggleCollapsible() {
    const content = document.getElementById('collapsible-content');
    if (content.style.maxHeight === '0px' || !content.style.maxHeight) {
      content.style.maxHeight = content.scrollHeight + 'px'; // Expand content
    } else {
      content.style.maxHeight = '0px'; // Collapse content
    }
  }
</script>

<style>
#feature-notebooks {
  scroll-margin-top: 100px;  /* Adjust this value to the height of your fixed/sticky header */
}
</style>
